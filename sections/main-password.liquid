<section class="password-page">
  <img src="{{ 'logo-circle.png' | asset_url }}" alt="{{ shop.name | escape }}" width="140" height="140">
  <h1 class="content-title">{{ section.settings.heading | escape }}</h1>
  {%- if shop.password_message != blank -%}
    <p class="body-large" style="max-width: 440px;">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'password-signup' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    {%- if form.posted_successfully? -%}
      <p class="form-message" role="status" style="width: 100%;">{{ 'password.signup_success' | t }}</p>
    {%- else -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert" style="width: 100%;">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label class="visually-hidden" for="PasswordSignup">{{ 'contact.email' | t }}</label>
      <input class="field" id="PasswordSignup" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'contact.email' | t }}">
      <button type="submit" class="button button--primary">{{ 'password.notify' | t }}</button>
    {%- endif -%}
  {%- endform -%}

  <details>
    <summary class="label" style="cursor: pointer;">{{ 'password.enter_with_password' | t }}</summary>
    {%- form 'storefront_password', class: 'password-login' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert" style="width: 100%;">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div style="display: flex; gap: 12px; margin-top: 16px; flex-wrap: wrap;">
        <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
        <input class="field" id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}" style="flex: 1; min-width: 200px;">
        <button type="submit" class="button button--secondary">{{ 'password.enter' | t }}</button>
      </div>
    {%- endform -%}
  </details>

  <span class="label muted">{{ 'password.admin_link_html' | t: link: '/admin' }}</span>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon."
    }
  ]
}
{% endschema %}
