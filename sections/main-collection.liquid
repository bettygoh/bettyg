{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    if collection.handle == 'all'
      assign heading = 'collections.shop' | t
    else
      assign heading = collection.title
    endif
  endif
-%}

{%- if section.settings.redirect_single and collection.products_count == 1 and request.design_mode == false -%}
  {%- assign only_product = collection.products.first -%}
  <script>window.location.replace({{ only_product.url | json }});</script>
  <noscript><meta http-equiv="refresh" content="0; url={{ only_product.url }}"></noscript>
{%- endif -%}

<section class="page-section">
  <div class="page-head">
    <h1 class="page-title">{{ heading | escape }}</h1>
    <span class="page-head__meta">
      {{- 'collections.count' | t: count: collection.products_count -}}
    </span>
  </div>

  {%- if section.settings.show_description and collection.description != blank -%}
    <div class="rte" style="max-width: 640px; margin-bottom: 40px;">{{ collection.description }}</div>
  {%- endif -%}

  {%- paginate collection.products by section.settings.per_page -%}
    {%- if collection.products.size > 0 -%}
      <ul class="product-grid">
        {%- for product in collection.products -%}
          <li>
            {%- liquid
              assign loading = 'lazy'
              if forloop.index <= 3
                assign loading = 'eager'
              endif
            -%}
            {% render 'product-card', product: product, show_single_color: section.settings.show_single_color, loading: loading %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="empty-state">
        <p>{{ 'collections.empty' | t }}</p>
        <a href="{{ routes.root_url }}" class="button button--secondary">{{ 'general.back_home' | t }}</a>
      </div>
    {%- endif -%}

    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "tag": "div",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection title. The all-products collection shows \"Shop\"."
    },
    {
      "type": "checkbox",
      "id": "redirect_single",
      "label": "Go straight to the product when there's only one",
      "info": "Visitors to a collection with a single product land on its product page.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_single_color",
      "label": "Add color to titles of single-color products",
      "info": "e.g. \"Abide Cap — Red\"",
      "default": true
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 6,
      "max": 48,
      "step": 3,
      "default": 24
    }
  ]
}
{% endschema %}
