<section class="page-section">
  <div class="page-head">
    <h1 class="page-title">{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}" class="page-head__meta">{{ 'customer.account.logout' | t }}</a>
  </div>

  <div class="two-col">
    <div class="stack stack--lg">
      <h2 class="label">{{ 'customer.account.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th scope="col">{{ 'customer.order.number' | t }}</th>
                  <th scope="col">{{ 'customer.order.date' | t }}</th>
                  <th scope="col">{{ 'customer.order.status' | t }}</th>
                  <th scope="col">{{ 'customer.order.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_net_amount | money_with_currency }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- else -%}
          <p class="body-large">{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    </div>

    <div class="stack stack--lg">
      <h2 class="label">{{ 'customer.account.details' | t }}</h2>
      {%- if customer.default_address -%}
        <address class="address">{{ customer.default_address | format_address }}</address>
      {%- else -%}
        <p class="body-large">{{ customer.name | escape }}<br>{{ customer.email | escape }}</p>
      {%- endif -%}
      <div><a href="{{ routes.account_addresses_url }}" class="button button--secondary">{{ 'customer.account.view_addresses' | t: count: customer.addresses_count }}</a></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Account",
  "tag": "div",
  "class": "section-main-account"
}
{% endschema %}
