<section class="page-section">
  <div class="page-head">
    <h1 class="page-title">{{ 'collections.list_title' | t }}</h1>
  </div>
  <ul class="product-grid">
    {%- for collection in collections -%}
      <li>
        <a href="{{ collection.url }}" class="card">
          <div class="card__media">
            {%- assign image = collection.featured_image | default: collection.products.first.featured_media -%}
            {%- if image -%}
              {{- image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw', widths: '360, 540, 720, 900, 1200' -}}
            {%- else -%}
              {{- 'collection-1' | placeholder_svg_tag -}}
            {%- endif -%}
          </div>
          <div class="card__meta">
            <span class="card__title">{{ collection.title | escape }}</span>
            <span class="card__price">{{ 'collections.count' | t: count: collection.products_count }}</span>
          </div>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "class": "section-main-list-collections"
}
{% endschema %}
