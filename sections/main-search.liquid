<section class="page-section">
  <div class="page-head">
    <h1 class="page-title">{{ 'search.title' | t }}</h1>
    {%- if search.performed -%}
      <span class="page-head__meta">{{ 'search.results_count' | t: count: search.results_count }}</span>
    {%- endif -%}
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="form-stack" style="max-width: 560px; margin-bottom: 48px;">
    <input type="hidden" name="type" value="product">
    <label class="visually-hidden" for="SearchInput">{{ 'search.placeholder' | t }}</label>
    <div style="display: flex; gap: 12px;">
      <input class="field" type="search" id="SearchInput" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <button type="submit" class="button button--primary">{{ 'search.submit' | t }}</button>
    </div>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count > 0 -%}
        <ul class="product-grid">
          {%- for item in search.results -%}
            <li>
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item, show_single_color: true, loading: 'lazy' %}
              {%- else -%}
                <a href="{{ item.url }}" class="card">
                  <span class="card__title">{{ item.title | escape }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="body-large">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search",
  "tag": "div",
  "class": "section-main-search"
}
{% endschema %}
