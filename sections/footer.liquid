<footer class="site-footer" {{ section.shopify_attributes }}>
  <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
    {% render 'wordmark', size: 'small' %}
  </a>

  <ul class="site-footer__links">
    {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
      {%- endfor -%}
    {%- else -%}
      {%- if section.settings.shop_link != blank -%}
        <li><a href="{{ section.settings.shop_link }}">{{ 'sections.footer.shop' | t }}</a></li>
      {%- endif -%}
      {%- if settings.social_instagram_link != blank -%}
        <li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">{{ 'sections.footer.instagram' | t }}</a></li>
      {%- endif -%}
      {%- if settings.social_tiktok_link != blank -%}
        <li><a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">{{ 'sections.footer.tiktok' | t }}</a></li>
      {%- endif -%}
      {%- if section.settings.contact_link != blank -%}
        <li><a href="{{ section.settings.contact_link }}">{{ 'sections.footer.contact' | t }}</a></li>
      {%- endif -%}
    {%- endif -%}
  </ul>

  <span class="site-footer__copy">
    &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name | escape }}
  </span>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Optional. Replaces the Shop / social / Contact links."
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop link",
      "default": "/collections/all"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link"
    },
    {
      "type": "paragraph",
      "content": "Instagram and TikTok links are set in Theme settings → Social media."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright name",
      "default": "abide.clo"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
