<section class="page-section">
  <div class="page-head">
    <h1 class="page-title">{{ 'customer.addresses.title' | t }}</h1>
    <a href="{{ routes.account_url }}" class="page-head__meta">{{ 'customer.account.return' | t }}</a>
  </div>

  {%- paginate customer.addresses by 10 -%}
    <div class="two-col">
      <div class="stack stack--lg">
        {%- for address in customer.addresses -%}
          <div class="stack" style="border-top: 1px solid var(--rule); padding-top: 20px;">
            {%- if address == customer.default_address -%}
              <span class="label eyebrow--accent">{{ 'customer.addresses.default' | t }}</span>
            {%- endif -%}
            <address class="address">{{ address | format_address }}</address>
            <details>
              <summary class="text-button">{{ 'customer.addresses.edit' | t }}</summary>
              <div style="margin-top: 20px;">
                {%- form 'customer_address', address, class: 'form-stack' -%}
                  {% render 'address-form', form: form, id: address.id %}
                  <div class="auth__links">
                    <button type="submit" class="button button--primary">{{ 'customer.addresses.update' | t }}</button>
                  </div>
                {%- endform -%}
              </div>
            </details>
            <form method="post" action="{{ address.url }}" onsubmit="return confirm({{ 'customer.addresses.delete_confirm' | t | json | escape }});">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="line-item__remove">{{ 'customer.addresses.delete' | t }}</button>
            </form>
          </div>
        {%- endfor -%}
        {% render 'pagination', paginate: paginate %}
      </div>

      <div class="stack stack--lg">
        <h2 class="label">{{ 'customer.addresses.add' | t }}</h2>
        {%- form 'customer_address', customer.new_address, class: 'form-stack' -%}
          {% render 'address-form', form: form, id: 'new' %}
          <div><button type="submit" class="button button--primary">{{ 'customer.addresses.add' | t }}</button></div>
        {%- endform -%}
      </div>
    </div>
  {%- endpaginate -%}
</section>

<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>
<script>
  window.addEventListener('load', function () {
    if (!window.Shopify || !Shopify.CountryProvinceSelector) return;
    document.querySelectorAll('select[id^="AddressCountry_"]').forEach(function (country) {
      var id = country.id.replace('AddressCountry_', '');
      new Shopify.CountryProvinceSelector('AddressCountry_' + id, 'AddressProvince_' + id, { hideElement: 'AddressProvince_' + id });
    });
  });
</script>

{% schema %}
{
  "name": "Addresses",
  "tag": "div",
  "class": "section-main-addresses"
}
{% endschema %}
