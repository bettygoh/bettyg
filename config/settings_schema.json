      },
      {
        "type": "color",
        "id": "color_image_bg",
        "label": "Image placeholder",
        "default": "#DDD8CA"
      },
      {
        "type": "color",
        "id": "color_panel",
        "label": "Panel (cart summary)",
        "default": "#E1DCCE"
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "text",
        "id": "wordmark_name",
        "label": "Wordmark",
        "default": "abide"
      },
      {
        "type": "text",
        "id": "wordmark_suffix",
        "label": "Wordmark suffix",
        "default": ".clo"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Header logo image",
        "info": "Optional. Replaces the live-type wordmark in the header."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo image width",
        "min": 60,
        "max": 240,
        "step": 4,
        "unit": "px",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Defaults to the abide.clo circle logo."
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social share image",
        "info": "Defaults to the abide.clo circle logo."
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "text",
        "id": "one_size_label",
        "label": "\"One size\" label",
